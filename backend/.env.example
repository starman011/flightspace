# Required
DATABASE_URL=postgres://user:password@localhost:5432/skydot?sslmode=disable
REDIS_URL=redis://localhost:6379

# Optional (with defaults)
PORT=8080
JWT_SECRET=change-me-in-production

# OpenSky Network credentials (registered account for higher rate limits)
OPENSKY_USER=your_opensky_username
OPENSKY_PASS=your_opensky_password

# AISStream.io API key — free at aisstream.io, enables real-time ship tracking
# Leave blank to disable ship tracking (satellites and aircraft still work)
AISSTREAM_KEY=

# CORS — comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:5173,https://your-app.pages.dev

# Data retention window in hours (default: 6)
RETENTION_HOURS=6

# ── Required ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://user:password@localhost:5432/skydot?sslmode=disable
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-to-a-long-random-string-in-production

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8080

# TLS_DOMAIN: set to your public domain (e.g. api.skydot.app) ONLY when the
# Go server is directly internet-facing and manages its own Let's Encrypt cert.
# Leave blank when running behind Railway / Cloudflare / any TLS-terminating proxy.
TLS_DOMAIN=

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
ALLOWED_ORIGINS=http://localhost:5173,https://skydot.app

# ── Data sources (all optional — features degrade gracefully when absent) ─────
OPENSKY_USER=your_opensky_username
OPENSKY_PASS=your_opensky_password
AISSTREAM_KEY=your_aisstream_api_key

# NASA API key — free at https://api.nasa.gov/ — enables asteroid/NEO tracking
# Without this, DEMO_KEY is used (very low rate limit, asteroids disabled)
NASA_API_KEY=your_nasa_api_key

# Launch Library 2 base URL — free tier, 15 req/hr
# Default: https://ll.thespacedevs.com/2.2.0 (no key needed for basic endpoints)
LL2_BASE_URL=https://ll.thespacedevs.com/2.2.0

# ── Tuning ────────────────────────────────────────────────────────────────────
POLL_INTERVAL_S=15
RETENTION_HOURS=6

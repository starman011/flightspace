# ── GitNexus ──────────────────────────────────────────────────────────────────
.gitnexus/

# ── Environment / secrets ────────────────────────────────────────────────────
.env
.env.local
.env.*.local
backend/.env
backend/.env.local
backend/.env.production
frontend/.env
frontend/.env.local
frontend/.env.production
# Never commit real certs or private keys
*.pem
*.key
*.p12
*.pfx
*.crt
/var/cache/autocert/

# ── Go ────────────────────────────────────────────────────────────────────────
backend/server
backend/backend
backend/*.exe
backend/tmp/

# ── Node / frontend ──────────────────────────────────────────────────────────
# Unanchored, so these match at the repo root too. The root package.json exists
# only so the Playwright VS Code extension can resolve the config, but npm still
# installs a full node_modules beside it — ~186 untracked files that were
# drowning real changes in git status.
node_modules/
dist/
.vite/

# ── OS & editor ──────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/settings.json
# macOS duplicate files (created by Finder copy operations)
*\ 2
*\ 2.*
*\ 2/

# ── Test artifacts ────────────────────────────────────────────────────────────
# Unanchored: the root Playwright config writes its reports beside itself.
test-results/
playwright-report/
coverage/

# ── Local backups ─────────────────────────────────────────────────────────────
*.bak

# ── Installed skill packages ─────────────────────────────────────────────────
# skills-lock.json is the tracked source of truth; the unpacked skills are
# reinstallable artifacts, same relationship as package-lock.json to node_modules.
.claude/skills/

# ── Docker volumes ────────────────────────────────────────────────────────────
infra/postgres_data/
infra/redis_data/
marketing/
